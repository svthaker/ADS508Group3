# Data Ingestion and Exploration for Food Access Research Atlas and Census Demographic Data (ACS)

# 1. Import libraries
import pandas as pd
import boto3


# 2. Test S3 bucket access
s3 = boto3.client("s3")

response = s3.list_objects_v2(
    Bucket="shrey-nutrition-data-ads508",
    Prefix="rawData/"
)

print("Objects found in bucket:", response.get("KeyCount", 0))

for obj in response.get("Contents", []):
    print(obj["Key"])


# 3. Load Food Access Research Atlas
food_access_path = "s3://shrey-nutrition-data-ads508/rawData/FoodAccess/Food Access Research Atlas.csv"

food_access_df = pd.read_csv(food_access_path)

food_access_df.head()


# 4. Explore Food Access dataset
print("Food Access shape:", food_access_df.shape)
print("\nFood Access columns:")
for col in food_access_df.columns:
    print(col)

print("\nFood Access info:")
food_access_df.info()

print("\nFood Access missing values:")
print(food_access_df.isnull().sum().head(20))

print("\nFood Access summary statistics:")
display(food_access_df.describe())


# 5. Select key Food Access columns
food_access_clean = food_access_df[
    [
        "CensusTract",
        "State",
        "County",
        "Urban",
        "Pop2010",
        "PovertyRate",
        "MedianFamilyIncome",
        "LowIncomeTracts",
        "LILATracts_1And10",
        "LILATracts_halfAnd10",
        "LILATracts_1And20",
        "TractHUNV",
        "TractSNAP"
    ]
].copy()

food_access_clean.head()


# 6. Check cleaned Food Access shape
print("Clean Food Access shape:", food_access_clean.shape)


# 7. Check missing values in cleaned Food Access data
print("Missing values before imputation:")
print(food_access_clean.isnull().sum())


# 8. Fill missing numeric values with median
food_access_clean["PovertyRate"] = food_access_clean["PovertyRate"].fillna(
    food_access_clean["PovertyRate"].median()
)

food_access_clean["MedianFamilyIncome"] = food_access_clean["MedianFamilyIncome"].fillna(
    food_access_clean["MedianFamilyIncome"].median()
)

food_access_clean["TractHUNV"] = food_access_clean["TractHUNV"].fillna(
    food_access_clean["TractHUNV"].median()
)

food_access_clean["TractSNAP"] = food_access_clean["TractSNAP"].fillna(
    food_access_clean["TractSNAP"].median()
)

print("Missing values after imputation:")
print(food_access_clean.isnull().sum())


# 9. Save cleaned Food Access data locally
food_access_clean.to_csv("food_access_clean.csv", index=False)
print("Saved local file: food_access_clean.csv")



# 10. Upload cleaned Food Access data to S3
s3.upload_file(
    "food_access_clean.csv",
    "shrey-nutrition-data-ads508",
    "processedData/food_access_clean.csv"
)

print("Uploaded to s3://shrey-nutrition-data-ads508/processedData/food_access_clean.csv")


# 11. Load ACS Census files for inspection
dp05_path = "s3://shrey-nutrition-data-ads508/rawData/ACSDP1Y2024.DP05-2026-03-13T140903.csv"
s1701_path = "s3://shrey-nutrition-data-ads508/rawData/ACSST1Y2024.S1701-2026-03-13T140807.csv"
s1901_path = "s3://shrey-nutrition-data-ads508/rawData/ACSST1Y2024.S1901-2026-03-13T140835.csv"

dp05_df = pd.read_csv(dp05_path)
s1701_df = pd.read_csv(s1701_path)
s1901_df = pd.read_csv(s1901_path)


# 12. Preview ACS files
print("DP05 preview:")
display(dp05_df.head(20))

print("S1701 preview:")
display(s1701_df.head(20))

print("S1901 preview:")
display(s1901_df.head(20))


# 13. Document ACS finding
print("""
Observation:
The ACS files (DP05, S1701, S1901) were successfully ingested from S3,
but inspection showed that they are national summary tables rather than
tract-level geographic datasets. Because they do not contain tract-level
rows for direct merging or preprocessing, they were not cleaned further
in this stage of the pipeline.
""")
